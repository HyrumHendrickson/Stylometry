# User-curated corpus and generated artifacts stay out of version control.
input/*
!input/.gitkeep
temp/*
!temp/.gitkeep
results/*
!results/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors and OS
.idea/
.vscode/
.DS_Store
